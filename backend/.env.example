# 复制为 .env 或直接设置环境变量（开发期全部可不填，均有默认值）
DATABASE_URL=sqlite:///./restaurant.db        # 生产: mysql+pymysql://user:pass@127.0.0.1:3306/restaurant
REDIS_URL=                                     # 可选，如 redis://127.0.0.1:6379/0；不填则用进程内广播（单进程够用）
JWT_SECRET=change-me-please
JWT_EXPIRE_MINUTES=720
WX_APPID=
WX_SECRET=
WX_LOGIN_MOCK=1                                # 1=开发期模拟 openid（免微信服务器）；生产置 0
AI_BASE_URL=                                   # 如 https://api.deepseek.com/v1（OpenAI 兼容）
AI_API_KEY=
AI_MODEL=deepseek-chat
KDS_TIMEOUT_MINUTES=15                         # KDS 超时预警阈值（分钟）
